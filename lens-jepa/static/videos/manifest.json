  "fidelity": "A clip is kept only if, for both models, replaying all 50 episodes of that condition reproduces the recorded success vector exactly (and the per-step physical trace).",
  "layout": "left: LeWM | centre: goal (not shifted) | right: LeWM + LeNS-JEPA"
 },
 "selection_rules": {
  "demo": "Pre-registered: for each (task, shift), the lowest-index official Test50 episode where LeWM + LeNS-JEPA succeeds and LeWM fails. If no such episode exists, the cell is skipped.",
